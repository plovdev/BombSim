<?xml version="1.0" encoding="UTF-8"?>
<nifty>
    <useStyles filename="nifty-default-styles.xml"/>
    <useControls filename="nifty-default-controls.xml"/>

    <useControls filename="assets/Interface/screens/header.xml"/>
    <useControls filename="assets/Interface/screens/footer.xml"/>

    <screen id="authors" controller="com.plovdev.bombsim.controls.gui.AuthorsScreenControl">
        <layer id="background" childLayout="center">
        </layer>

        <layer id="foreground" childLayout="center">
            <panel id="dialog" width="100%" height="100%" childLayout="vertical" backgroundColor="#222f">
                <text text="Authors" font="aurulent-sans-16.fnt" width="100%" height="40px"/>
                <control id="profileScrollPanel" name="scrollPanel" width="100%" height="100%"
                         horizontal="false" vertical="true">
                    <panel id="profileContainer" childLayout="vertical" width="100%" padding="10px">
                    </panel>
                </control>
            </panel>

            <control name="footer"/>
        </layer>
    </screen>
</nifty>
