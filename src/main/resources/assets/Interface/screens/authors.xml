<?xml version="1.0" encoding="UTF-8"?>
<nifty>
    <useStyles filename="nifty-default-styles.xml"/>
    <useControls filename="nifty-default-controls.xml"/>
    <useControls filename="assets/Interface/screens/footer.xml"/>

    <style id="transparent-scrollpanel">
        <attributes backgroundColor="#0000"/>
    </style>
    <style id="transparent-scrollpanel#background">
        <attributes backgroundColor="#0000"/>
    </style>
    <style id="transparent-scrollpanel#clip">
        <attributes backgroundColor="#0000"/>
    </style>

    <screen id="authors" controller="com.plovdev.bombsim.controls.gui.AuthorsScreenControl">
        <layer id="background" childLayout="center">
        </layer>

        <layer id="foreground" childLayout="center">
            <panel id="dialog" width="100%" height="100%" childLayout="vertical">
                <panel id="meta" width="100%" height="40px" childLayout="horizontal" backgroundColor="#222f">
                    <text text="Authors" font="aurulent-sans-16.fnt" width="*" height="40px" textAlign="left"
                          padding="10px"/>
                    <panel width="40px" height="40px" childLayout="center">
                        <image filename="assets/Interface/Icons/close.png" width="20px" height="20px">
                            <interact onClick="back()"/>
                        </image>
                    </panel>
                </panel>

                <control id="profileScrollPanel" name="scrollPanel" style="transparent-scrollpanel" width="100%"
                         height="*" horizontal="false" vertical="true">
                    <panel id="profileContainer" childLayout="vertical" width="100%" padding="20px">
                    </panel>
                </control>

                <panel id="links-block-out" width="100%" height="40px" childLayout="center" backgroundColor="#222f">
                    <panel id="links-block-in" width="20%" height="40px" childLayout="horizontal">
                        <image filename="assets/Interface/Icons/Authors/github.png" valign="center" width="30px"
                               height="30px">
                            <interact onClick="openLink(https://github.com/plovdev/BombSim)"/>
                        </image>
                        <panel width="*" height="100%"/>
                        <image filename="assets/Interface/Icons/Authors/telegram.png" valign="center" width="30px"
                               height="30px">
                            <interact onClick="openLink(https://t.me/plovdev_official)"/>
                        </image>
                    </panel>
                </panel>

                <panel width="100%" height="30px"/>
            </panel>

            <control name="footer"/>
        </layer>
    </screen>
</nifty>